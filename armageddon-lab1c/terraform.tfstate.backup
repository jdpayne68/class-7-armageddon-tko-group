              }
            ],
            "private_ip": "10.30.1.44",
            "public_dns": "ec2-13-219-242-165.compute-1.amazonaws.com",
            "public_ip": "13.219.242.165",
            "region": "us-east-1",
            "root_block_device": [
              {
                "delete_on_termination": true,
                "device_name": "/dev/xvda",
                "encrypted": false,
                "iops": 3000,
                "kms_key_id": "",
                "tags": {},
