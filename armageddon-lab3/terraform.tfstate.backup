            "private_ip": "10.30.1.92",
            "public_dns": "ec2-52-195-176-251.ap-northeast-1.compute.amazonaws.com",
            "public_ip": "52.195.176.251",
            "region": "ap-northeast-1",
            "root_block_device": [
              {
                "delete_on_termination": true,
                "device_name": "/dev/xvda",
                "encrypted": false,
                "iops": 3000,
                "kms_key_id": "",
