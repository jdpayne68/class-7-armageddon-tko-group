            "private_ip": "10.80.1.89",
            "public_dns": "ec2-52-67-145-79.sa-east-1.compute.amazonaws.com",
            "public_ip": "52.67.145.79",
            "region": "sa-east-1",
            "root_block_device": [
              {
                "delete_on_termination": true,
                "device_name": "/dev/xvda",
                "encrypted": false,
                "iops": 3000,
                "kms_key_id": "",
